# AI Pronunciation Coach — example environment file.
#
# Copy to `.env` and fill in real values locally. `.env` is git-ignored and must
# never be committed.
#
# DATABASE_URL, JWT_SECRET and PORT are READ BY THE BACKEND and required —
# the server refuses to start without a database URL and a JWT secret.
# The remaining variables are declared for upcoming work and are not read yet.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
# NOTE: port 8080 may already be taken locally (GitPulse). Override if needed.
PORT=8080

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# REQUIRED.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_pronunciation_coach?sslmode=disable

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. At least 32 bytes. There is no default: the server will not start
# without it, so a weak fallback secret can never reach production.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Pronunciation provider
# The final provider is chosen after the Phase 0 evaluation.
# ---------------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------------------------------------------------------------------------
# Object storage (audio files)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Subscriptions
# ---------------------------------------------------------------------------
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
