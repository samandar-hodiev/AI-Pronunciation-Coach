# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# macOS / editors
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
bin/
dist/
*.exe
*.test
*.out
coverage.out
vendor/

# ---------------------------------------------------------------------------
# Flutter / Dart
# ---------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
# 'build' without a trailing slash so it also matches a symlinked build dir
# (see README: iOS builds are redirected outside the iCloud-synced Desktop).
build
.flutter-plugins
.flutter-plugins-dependencies
*.iml
doc/api/

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/key.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.jks
*.keystore

# ---------------------------------------------------------------------------
# iOS / macOS
# ---------------------------------------------------------------------------
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.perspectivev3
**/ios/**/*.pbxuser
**/ios/**/xcuserdata/

# iCloud "Desktop & Documents" sync creates conflict duplicates of Flutter's
# generated iOS config, e.g. "Generated 2.xcconfig". Match those variants too.
**/Flutter/Generated*.xcconfig
**/Flutter/flutter_export_environment*.sh

# ---------------------------------------------------------------------------
# Docker / local data
# ---------------------------------------------------------------------------
.docker-data/
postgres-data/
